	chosen {
		stdout-path = "serial2:1500000n8";
	};

	vcc5v0_in {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_in";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		phandle = <0xc7>;
	};

	external-gmac1-clock {
		compatible = "fixed-clock";
		clock-frequency = <0x7735940>;
		clock-output-names = "gmac1_clkin";
		#clock-cells = <0x00>;
		phandle = <0x4d>;
	};

	hdmi-con {
		compatible = "hdmi-connector";
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0xc6>;
				phandle = <0x5f>;
			};
		};
	};

	vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x20>;
		phandle = <0x24>;
	};

	vcc5v0_sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0xc7>;
		phandle = <0x20>;
	};

	vcc5v0-host-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		enable-active-high;
		gpio = <0x21 0x06 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xc8>;
		regulator-always-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x20>;
		phandle = <0xb8>;
	};

	vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		enable-active-high;
		gpio = <0x21 0x05 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xc9>;
		regulator-always-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x20>;
		phandle = <0xb9>;
	};

	vcc3v3-pcie-p-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x21 0x14 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xca>;
		regulator-name = "vcc3v3_pcie_p";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x1b>;
		phandle = <0x63>;
	};

	leds {
		compatible = "gpio-leds";

		power {
			label = "firefly:blue:power";
			linux,default-trigger = "ir-power-click";
			default-state = "on";
			gpios = <0x21 0x1b 0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0xcb>;
		};

		user {
			label = "firefly:yellow:user";
			linux,default-trigger = "ir-user-click";
			default-state = "off";
			gpios = <0x21 0x1c 0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0xcc>;
		};
	};

	sdio-pwrseq {
		status = "okay";
		compatible = "mmc-pwrseq-simple";
		clocks = <0x94 0x01>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <0xcd>;
		reset-gpios = <0x95 0x09 0x01>;
		phandle = <0x69>;
	};

	rk809-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "Analog RK809";
		simple-audio-card,mclk-fs = <0x100>;

		simple-audio-card,cpu {
			sound-dai = <0xce>;
		};

		simple-audio-card,codec {
			sound-dai = <0x94>;
		};
	};

	rk-headset {
		compatible = "rockchip_headset";
		headset_gpio = <0x95 0x1a 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xcf>;
		io-channels = <0xd0 0x02>;
	};
};
